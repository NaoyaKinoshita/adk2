# Vertex AI (Gemini)
GOOGLE_CLOUD_PROJECT=your-project-id
# global エンドポイントは空いているリージョンに自動でルーティングされ、429 が出にくい
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=True
GEMINI_MODEL=gemini-2.5-flash

# BigQuery
# クエリの課金先プロジェクト (未指定時は GOOGLE_CLOUD_PROJECT)
BQ_COMPUTE_PROJECT_ID=
# エージェントに参照させるデータセット (project.dataset)
BQ_DATASET=healthy-matter-465806-v4.genui_demo
# データセットのロケーション
BQ_LOCATION=asia-northeast1
